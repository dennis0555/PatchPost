# Kopiere diese Datei nach ".env" und trag deine Werte ein.

# Bot-Token aus dem Discord Developer Portal (Pflicht). Niemals teilen!
DISCORD_TOKEN=

# Wie oft (in Minuten) alle Quellen geprüft werden. Minimum: 2
POLL_MINUTES=10

# Optional: Server-ID zum Entwickeln. Slash-Befehle erscheinen dort sofort
# statt global (global kann ein paar Minuten dauern).
DEV_GUILD_ID=

# Meldungen in Ankündigungskanälen automatisch veröffentlichen (true/false)
AUTO_PUBLISH=true

# Speicherort der Datenbank
DB_PATH=patchpost.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Sprache der Riot-News (de-de, en-us, en-gb, fr-fr, ...)
RIOT_LOCALE=de-de

# Land und Sprache für Epic-Gratisspiele und Fortnite-News
EPIC_COUNTRY=DE
EPIC_LOCALE=de
